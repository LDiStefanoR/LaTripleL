# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Copia generada desde recursos/ (ver scripts/sync-recursos.mjs)
/public/recursos/imagenes-productos/*
!/public/recursos/imagenes-productos/.gitkeep
/public/recursos/imagenes-rubros/*
!/public/recursos/imagenes-rubros/.gitkeep
/public/recursos/web/*
!/public/recursos/web/.gitkeep
/public/recursos/logo.png
/app/icon.png
/app/apple-icon.png

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# datos locales de clientes (hashes, deudas, PINs)
/data/usuarios.json
/data/pedidos.json
/data/cuentas.json

# Google Drive (cuenta de servicio)
/secrets/
*service-account*.json
google-credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
